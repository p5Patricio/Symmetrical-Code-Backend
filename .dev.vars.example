# Meta WhatsApp Cloud API credentials
WHATSAPP_ACCESS_TOKEN=your_meta_system_user_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_VERIFY_TOKEN=your_custom_webhook_verification_token_here

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# Telegram Bot API (internal notifications)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Environment & Security
ADMIN_API_KEY=your_optional_admin_api_key_for_manual_reactivation
