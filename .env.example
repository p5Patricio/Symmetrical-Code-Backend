# ================================
# Symmetrical Code Backend - Variables de Entorno
# ================================

# Puerto del servidor (default: 3001)
PORT=3001

# URL del frontend para CORS (desarrollo)
FRONTEND_URL=http://localhost:5173

# Groq API Key - Obtenéla gratis en: https://console.groq.com/keys
GROQ_API_KEY=tu_api_key_de_groq_aqui

# Modelo de Groq a utilizar
GROQ_MODEL=llama-3.3-70b-versatile

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=Tu_access_token_de_whatsapp_aqui
WHATSAPP_PHONE_NUMBER_ID=Tu_phone_number_id_de_whatsapp_aqui
WHATSAPP_VERIFY_TOKEN=tu_verify_token_de_whatsapp_aqui

# Resend - Envío de correos
RESEND_API_KEY=RESEND_API_KEY_AQUI
EMAIL_FROM=Symmetrical Code <noreply@tu-dominio.com>
EMAIL_ADMINS=admin0@gmail.com,admin1@gmail.com,admin2@gmail.com
