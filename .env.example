# ================================
# Symmetrical Code Backend - Variables de Entorno
# ================================

# Puerto del servidor (default: 3001)
PORT=3001

# URL del frontend para CORS (desarrollo)
FRONTEND_URL=http://localhost:5173

# Google Gemini API Key - Obtenéla gratis en: https://aistudio.google.com/app/apikey
# Nivel gratuito: 1,500 requests/día con Gemini 2.5 Flash-Lite
GEMINI_API_KEY=tu_api_key_de_gemini_aqui

# Modelo de Gemini a utilizar (recomendado para gratis: gemini-2.5-flash-lite-preview-06-17)
GEMINI_MODEL=gemini-2.5-flash-lite-preview-06-17
